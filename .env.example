PORT=8787

# Otak karyawan (gratis): https://aistudio.google.com/apikey
# Kosongkan untuk memakai templat lokal.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Alamat publik server ini (dipakai untuk redirect OAuth & URL video Instagram).
PUBLIC_BASE_URL=http://localhost:8787

# YouTube: OAuth Client (Web application) dari Google Cloud Console,
# aktifkan YouTube Data API v3, redirect URI: <PUBLIC_BASE_URL>/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok Content Posting API: https://developers.tiktok.com
# Redirect URI: <PUBLIC_BASE_URL>/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram Graph API (akun Professional). Token long-lived dengan izin instagram_content_publish.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# graph.facebook.com (login lewat Facebook Page) atau graph.instagram.com (Instagram Login)
INSTAGRAM_GRAPH_HOST=graph.facebook.com
INSTAGRAM_API_VERSION=v23.0
# resumable (kirim file langsung) atau url (Instagram mengambil dari PUBLIC_BASE_URL)
INSTAGRAM_UPLOAD_MODE=resumable
