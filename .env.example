PORT=8787

# Otak karyawan (gratis): https://aistudio.google.com/apikey
# Kosongkan untuk memakai templat lokal.
GEMINI_API_KEY=
# Beberapa model dipisah koma: kalau yang pertama sibuk, pindah ke berikutnya.
GEMINI_MODEL=gemini-flash-latest,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash
GEMINI_TIMEOUT_MS=45000

# Alamat publik server ini (dipakai untuk redirect OAuth & URL video Instagram).
PUBLIC_BASE_URL=http://localhost:8787

# YouTube: OAuth Client (Web application) dari Google Cloud Console,
# aktifkan YouTube Data API v3, redirect URI: <PUBLIC_BASE_URL>/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok Content Posting API: https://developers.tiktok.com
# Redirect URI: <PUBLIC_BASE_URL>/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# video.upload = kirim ke draft TikTok. Tambahkan ,video.list kalau scope itu aktif (statistik otomatis)
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload
# Redirect yang didaftarkan di Login Kit. Halaman GitHub Pages ini meneruskan ke http://localhost:8787,
# jadi tidak perlu tunnel. Kosongkan untuk memakai <PUBLIC_BASE_URL>/api/oauth/tiktok/callback.
TIKTOK_REDIRECT_URI=https://riskiwahyusaputra.github.io/kantor-piksel/tiktok-callback.html

# Instagram Graph API (akun Professional). Token long-lived dengan izin instagram_content_publish.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# graph.facebook.com (login lewat Facebook Page) atau graph.instagram.com (Instagram Login)
INSTAGRAM_GRAPH_HOST=graph.facebook.com
INSTAGRAM_API_VERSION=v23.0
# resumable (kirim file langsung) atau url (Instagram mengambil dari PUBLIC_BASE_URL)
INSTAGRAM_UPLOAD_MODE=resumable

# Gambar otomatis (Pollinations/Flux) gratis tanpa kunci: 1 gambar / 45 detik dan ada watermark kecil.
# Kunci gratis dari https://enter.pollinations.ai menghapus watermark & mempercepat.
POLLINATIONS_KEY=

# Narasi ElevenLabs (akun yang sama dengan di Antigravity): https://elevenlabs.io/app/settings/api-keys
# Kosongkan untuk memakai Edge TTS gratis. ELEVENLABS_VOICE_ID opsional (suara pilihanmu dari Voice Library).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Model: eleven_v3 (bawaan, paling fasih bahasa Indonesia), eleven_multilingual_v2, eleven_flash_v2_5 (cepat & hemat)
ELEVENLABS_MODEL=
